rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /categories/{categoryId} {
      allow read, write: if isValidId(categoryId);
    }

    match /products/{productId} {
      allow read, write: if isValidId(productId);
    }

    match /media_assets/{assetId} {
      allow read, write: if isValidId(assetId);
    }

    match /pages/{pageId} {
      allow read: if isValidId(pageId);
      allow write: if request.auth != null;
    }

    match /testimonials/{testimonialId} {
      allow read: if isValidId(testimonialId);
      allow write: if request.auth != null;
    }

    match /faqs/{faqId} {
      allow read: if isValidId(faqId);
      allow write: if request.auth != null;
    }

    match /settings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if request.auth != null;
    }

    match /audit_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
